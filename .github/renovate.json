{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "extends": ["config:base", ":preserveSemverRanges"],
  "labels": ["deps"],
  "ignoreDeps": [],
  "major": {
    "automerge": false
  },
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "Upgrade the Vite+ toolchain with `vp upgrade` and `vp migrate`, because these versions must move together",
      "matchPackageNames": [
        "vite-plus",
        "vite",
        "@voidzero-dev/vite-plus-core",
        "vitest",
        "@vitest/*"
      ],
      "enabled": false
    },
    {
      "description": "typedoc 0.28 supports TypeScript <= 6.0. Keep the pnpm catalog (the packages) on TypeScript 6 until typedoc supports 7",
      "matchFileNames": ["pnpm-workspace.yaml"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}
